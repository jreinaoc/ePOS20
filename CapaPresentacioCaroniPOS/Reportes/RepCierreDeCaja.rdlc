    <Variable Name="SaldoFinanciamiento">
      <Value>=Sum(Fields!MANUALFINANCIAMIENTO.Value, "DS_VW_CierreCaja")-Sum(Fields!SISTEMAFINANCIAMIENTO.Value, "DS_VW_CierreCaja")</Value>
