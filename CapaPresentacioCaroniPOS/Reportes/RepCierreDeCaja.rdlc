    </Variable>
    <Variable Name="TotalManual">
      <Value>=Sum(Fields!MANUALEFECTIVO.Value, "DS_VW_CierreCaja")+Sum(Fields!MANUALCHEQUES.Value, "DS_VW_CierreCaja")+Sum(Fields!MANUALTARJETA.Value, "DS_VW_CierreCaja")+Sum(Fields!MANUALDEBITO.Value, "DS_VW_CierreCaja")+Sum(Fields!MANUALCREDITO.Value, "DS_VW_CierreCaja")+Sum(Fields!MANUALGASTOS.Value, "DS_VW_CierreCaja")+Sum(Fields!MANUALFINANCIAMIENTO.Value, "DS_VW_CierreCaja")+Sum(Fields!ManualIVARetenido.Value, "DS_VW_CierreCaja")+Sum(Fields!ManualISLRRetenido.Value, "DS_VW_CierreCaja")+Sum(Fields!MANUALCUPONES.Value, "DS_VW_CierreCaja")+Sum(Fields!MANUALTICKETSALUD.Value, "DS_VW_CierreCaja")+Sum(Fields!MANUALTICKETSALUDEFEC.Value, "DS_VW_CierreCaja")+Sum(Fields!MANUALTRANSFERENCIA.Value, "DS_VW_CierreCaja")</Value>
    </Variable>
    <Variable Name="TotalSistema">
