                  </TextRun>
                  <TextRun>
                    <Value>_______________, venezolano(a), mayor de edad y titular de la cédula de identidad Personal </Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Calibri</FontFamily>
                      <FontWeight>Normal</FontWeight>
